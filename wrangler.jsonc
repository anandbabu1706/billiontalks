{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "billiontalks-realtime-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-18",
  "workers_dev": true,
  "rules": [
    {
      "type": "Data",
      "fallthrough": false,
      "globs": [
        "**/*.png"
      ]
    }
  ],
  "vars": {
    "ACCOUNT_EMAIL_FROM": "BillionTalks <no-reply@mail.billiontalks.com>",
    "ACCOUNT_PUBLIC_ORIGIN": "https://billiontalks.com/",
    "LIMITED_RELEASE_MEDIA_DISABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "ACCOUNT_DB",
      "database_name": "billiontalks-accounts",
      "database_id": "0c0c10f2-437e-459e-86fb-360d7e2a36b5"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MEETING_STORE",
        "class_name": "MeetingStateDurableObject"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "RECORDINGS_BUCKET",
      "bucket_name": "billiontalks-recordings"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MeetingStateDurableObject"
      ]
    }
  ]
}
